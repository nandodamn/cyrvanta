{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyrvanta:playbook:synthetic-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "parameters", "evidence_refs"],
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "parameters": {"type": "object"},
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "format": "uuid"}
    }
  }
}
