# Cyrvanta lab LDAP seed data.
# Imported once, on first boot, by osixia/openldap's bootstrap mechanism.
# Base DN: dc=cyrvanta-lab,dc=local (set via LDAP_DOMAIN in docker-compose.yml)

dn: ou=people,dc=cyrvanta-lab,dc=local
objectClass: organizationalUnit
ou: people

