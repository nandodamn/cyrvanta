cn: Jane Doe
sn: Doe
givenName: Jane
mail: jdoe@cyrvanta-lab.local
displayName: Jane Doe
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/jdoe
loginShell: /bin/bash
