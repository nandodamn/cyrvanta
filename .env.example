ENVIRONMENT=development
COMPOSE_PROFILES=core
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEFAULT_LOCALE=es-UY
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:5173

POSTGRES_DB=cyrvanta
POSTGRES_USER=cyrvanta
POSTGRES_PASSWORD=change-me
POSTGRES_APP_USER=cyrvanta_app
POSTGRES_APP_PASSWORD=change-me-too
DATABASE_ADMIN_URL=postgresql+asyncpg://cyrvanta:change-me@postgres:5432/cyrvanta
DATABASE_URL=postgresql+asyncpg://cyrvanta_app:change-me-too@postgres:5432/cyrvanta

REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=cyrvanta
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://cyrvanta:change-me@rabbitmq:5672/
EVENT_MAX_PAYLOAD_BYTES=262144
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_POLL_INTERVAL_SECONDS=1
EVENT_HANDLER_TIMEOUT_SECONDS=30
EVENT_CONSUMER_PREFETCH=16
EVENT_RETRY_DELAYS_SECONDS=5,30,300

JWT_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-for-this-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Optional override. Defaults to true outside development/test.
# SESSION_COOKIE_SECURE=true
OPENSEARCH_MODE=simulated
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_MODE=simulated
WAZUH_MANAGER_HOST=wazuh-manager
WAZUH_MANAGER_PORT=1514
OLLAMA_MODE=simulated
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
AI_REQUEST_TIMEOUT_SECONDS=120
N8N_MODE=simulated
N8N_BASE_URL=http://n8n:5678
N8N_EDITOR_URL=http://localhost:5678
# Create this key in the local n8n owner account. It is read by the backend only.
N8N_API_KEY=
N8N_ALLOWED_WORKFLOW_IDS=cyrvanta-demo-response
AUTOMATION_KILL_SWITCH=false
DIRECTORY_DEMO_ENABLED=false
DIRECTORY_DEMO_USERNAME=ldap-demo
DIRECTORY_DEMO_PASSWORD=replace-for-local-demo-only

BOOTSTRAP_TENANT_NAME=Cyrvanta Demo
BOOTSTRAP_TENANT_SLUG=cyrvanta-demo
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-before-use
